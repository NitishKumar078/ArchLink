{
  "name": "archlink",
  "displayName": "Archlink",
  "icon": "images/icon.png",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "description": "Interactive dependency graph for React and Next.js: routes, components, hooks and services, with imports traced through barrel files.",
  "keywords": [
    "react",
    "nextjs",
    "dependency graph",
    "import graph",
    "component tree",
    "architecture",
    "visualization",
    "typescript"
  ],
  "engines": {
    "vscode": "^1.84.0",
    "node": ">=22.6.0"
  },
  "type": "module",
  "scripts": {
    "probe": "node src/probe.ts",
    "test": "node --test \"src/**/*.test.ts\"",
    "gate": "node scripts/gate.mjs",
    "build": "node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "package": "npx --yes @vscode/vsce package --no-dependencies -o archlink.vsix",
    "smoke:host": "powershell -ExecutionPolicy Bypass -File scripts/smoke-host.ps1",
    "typecheck": "tsc --noEmit",
    "preview": "node scripts/preview.mjs"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.1.3",
    "@xyflow/react": "^12.12.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "5.9.3"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/vscode": "^1.84.0",
    "esbuild": "^0.28.2"
  },
  "main": "./out/extension.cjs",
  "publisher": "local-dev",
  "categories": [
    "Visualization",
    "Programming Languages"
  ],
  "activationEvents": [],
  "contributes": {
    "commands": [
      {
        "command": "archlink.showGraph",
        "title": "Show Project Relationships",
        "category": "Archlink"
      },
      {
        "command": "archlink.showGraphForFile",
        "title": "Show Relationships for This File",
        "category": "Archlink"
      }
    ],
    "menus": {
      "editor/title/context": [
        {
          "command": "archlink.showGraphForFile",
          "group": "navigation",
          "when": "resourceLangId =~ /^(typescript|typescriptreact|javascript|javascriptreact)$/"
        }
      ],
      "explorer/context": [
        {
          "command": "archlink.showGraphForFile",
          "group": "navigation",
          "when": "resourceLangId =~ /^(typescript|typescriptreact|javascript|javascriptreact)$/"
        }
      ],
      "commandPalette": [
        {
          "command": "archlink.showGraphForFile",
          "when": "false"
        }
      ]
    }
  }
}
